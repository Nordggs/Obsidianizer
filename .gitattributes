# Normalize line endings for text files
* text=auto

# Source code — LF for consistency across platforms
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Mark generated config template as text too
config.example.yml text eol=lf

# Binary assets stay untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.webp binary